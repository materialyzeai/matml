# MatGL (>= 4.1.4) + LAMMPS built with KOKKOS host backends (OpenMP + Serial) and
# the native `pair_style matgl` / `matgl/kk` from matgl/lammps. CPU only.
# For the CUDA build, see Dockerfile.matgl.kokkos.
#
# linux/amd64 only (no prebuilt CPU libtorch zip for arm64).
#
# Build:
#   docker build -f docker/Dockerfile.matgl.kokkos-cpu -t materialyzeai/matgl:latest-kokkos-cpu .
#
# Run (single rank; pair_matgl does not support multi-rank domain decomposition):
#   mgl create-lammps-model -m materialyze/TensorNet-MatPES-r2SCAN -o model.pt --dtype float32
#   lmp -k on t 8 -sf kk -pk kokkos newton on neigh half -in in.lammps   # Kokkos/OpenMP
#   lmp -in in.lammps                                                    # plain pair_style matgl

########################################################################
# Builder
########################################################################
FROM debian:bookworm AS builder

# matgl tag that provides lammps/ sources (pair_matgl, pair_matgl_kokkos).
ARG MATGL_VERSION=4.1.4
# LAMMPS release verified by matgl upstream.
ARG LAMMPS_VERSION=stable_22Jul2025_update5
# CPU libtorch, CXX11 ABI; matches matgl's own host-Kokkos CI job.
ARG LIBTORCH_VERSION=2.5.1
ARG CMAKE_VERSION=3.31.6
ARG BUILD_JOBS=4

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update -y && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        libfftw3-dev \
        libjpeg-dev \
        libpng-dev \
        ninja-build \
        pkg-config \
        python3 \
        unzip \
    && rm -rf /var/lib/apt/lists/*

# LAMMPS requires a newer CMake than Debian ships.
RUN curl -fsSL "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz" \
        | tar -xz -C /usr/local --strip-components=1

RUN curl -fsSL -o /tmp/libtorch.zip \
        "https://download.pytorch.org/libtorch/cpu/libtorch-cxx11-abi-shared-with-deps-${LIBTORCH_VERSION}%2Bcpu.zip" \
    && unzip -q /tmp/libtorch.zip -d /opt \
    && rm /tmp/libtorch.zip

RUN git clone --depth 1 --branch "v${MATGL_VERSION}" https://github.com/materialyzeai/matgl.git /opt/matgl \
    && git clone --depth 1 --branch "${LAMMPS_VERSION}" https://github.com/lammps/lammps.git /opt/lammps-src

# Register ML-MATGL (+ Kokkos variant) before GenerateStyleHeaders().
RUN python3 /opt/matgl/lammps/src/ML-MATGL/patch_lammps.py /opt/lammps-src /opt/matgl

# lmp finds libtorch via RPATH rather than LD_LIBRARY_PATH, so the Python torch
# wheel in the runtime image never picks up these (different-version) libs.
# MKL_INCLUDE_DIR: works around libtorch's Caffe2 config leaking MKL_INCLUDE_DIR-NOTFOUND.
RUN cmake -B /opt/lammps-build -S /opt/lammps-src/cmake -G Ninja \
        -D CMAKE_BUILD_TYPE=Release \
        -D CMAKE_INSTALL_PREFIX=/opt/lammps \
        -D CMAKE_CXX_STANDARD=17 \
        -D CMAKE_PREFIX_PATH=/opt/libtorch \
        -D CMAKE_INSTALL_RPATH=/opt/libtorch/lib \
        -D MKL_INCLUDE_DIR=/usr/include \
        -D BUILD_MPI=OFF \
        -D BUILD_OMP=ON \
        -D BUILD_SHARED_LIBS=OFF \
        -D PKG_KOKKOS=ON \
        -D Kokkos_ENABLE_SERIAL=ON \
        -D Kokkos_ENABLE_OPENMP=ON \
        -D PKG_ML-MATGL=ON \
        -D MATGL_PYTHON_EXECUTABLE=/usr/local/bin/python3 \
        -D PKG_MANYBODY=ON \
        -D PKG_MOLECULE=ON \
        -D PKG_EXTRA-COMPUTE=ON \
        -D PKG_EXTRA-DUMP=ON \
        -D PKG_EXTRA-FIX=ON \
    && cmake --build /opt/lammps-build -j "${BUILD_JOBS}" \
    && cmake --install /opt/lammps-build

########################################################################
# Runtime
########################################################################
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

ARG MATGL_VERSION=4.1.4

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update -y && apt-get install -y --no-install-recommends \
        libfftw3-double3 \
        libgomp1 \
        libjpeg62-turbo \
        libpng16-16 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/libtorch/lib /opt/libtorch/lib
COPY --from=builder /opt/lammps /opt/lammps
# pair_matgl shells out to export_matgl_checkpoint.py (path baked in at build time)
# when pair_coeff is given a raw matgl checkpoint directory.
COPY --from=builder /opt/matgl/lammps /opt/matgl/lammps

# CPU-only torch wheel keeps the image small.
RUN UV_TORCH_BACKEND=cpu uv pip install --system --no-cache "matgl>=${MATGL_VERSION}"

ENV PATH="/opt/lammps/bin:${PATH}" \
    MATGL_PYTHON=/usr/local/bin/python3 \
    OMP_PROC_BIND=spread \
    OMP_PLACES=threads

WORKDIR /work
