# MatML stack (matgl, matcalc, matpes) on top of LAMMPS with KOKKOS (OpenMP) and
# the native `pair_style matgl` / `matgl/kk`. CPU only, linux/amd64 only.
FROM materialyzeai/matgl:latest-kokkos-cpu

# CPU-only torch wheel, pinned to the torch the base image built LAMMPS against.
RUN UV_TORCH_BACKEND=cpu uv pip install --system --no-cache -c /opt/lammps/torch-constraint.txt "matgl>=4.1.4" matcalc matpes
