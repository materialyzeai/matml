# materialyzeai/matgl:latest-dgl  (legacy)
#
# matgl:latest with DGL 2.1.0 and torch 2.2.0. linux/amd64 and linux/arm64.
#
# MatGL removed the DGL backend in v4.0.0, so with matgl >= 4.1.4 from the base
# image, MATGL_BACKEND=DGL has no effect and the DGL models are not available.
# Kept for existing users; for DGL models, use an environment with matgl < 4.
FROM materialyzeai/matgl:latest

LABEL org.opencontainers.image.title="matgl-dgl" \
      org.opencontainers.image.description="Legacy: matgl:latest with DGL 2.1.0 and torch 2.2.0. MatGL >= 4 has no DGL backend." \
      org.opencontainers.image.source="https://github.com/materialyzeai/matml"

ENV DGLBACKEND=pytorch
ENV MATGL_BACKEND=DGL

RUN uv pip install --system dgl==2.1.0 torch==2.2.0 torchdata==0.7.1
